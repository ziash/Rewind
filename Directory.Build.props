<Project>
  <!-- Settings shared by every project in the solution. Copied from Trader's Directory.Build.props (commit a41db3d). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1608: cTrader.OpenAPI.Net pins old dependency ranges (same as in Trader); NU1903 etc. stay errors. -->
    <WarningsNotAsErrors>NU1608</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
