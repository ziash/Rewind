<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Rewind</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page is served from next to the program, so a published build runs from any folder. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\*.json" Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rewind.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.OpenAPI.Net" Version="1.4.4" />
  </ItemGroup>

</Project>
